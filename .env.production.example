# CampusCare AI — Production Environment Configuration (.env.production.example)
ENVIRONMENT=production
DEBUG=false

# Tenancy & Database Configuration (Non-owner runtime user NOBYPASSRLS)
DATABASE_URL=postgresql+psycopg://campuscare_app:REPLACE_WITH_STRONG_APP_PASSWORD@db.production.internal:5432/campuscare
MIGRATION_DATABASE_URL=postgresql+psycopg://campuscare_migrator:REPLACE_WITH_STRONG_MIGRATOR_PASSWORD@db.production.internal:5432/campuscare

# Security & Sessions (ADR-003)
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true
SESSION_EXPIRY_HOURS=24

# CORS & Trusted Origins
CORS_ORIGINS=["https://campuscare.apex.edu","https://app.campuscare.apex.edu"]

# Storage & Attachments (S3 Compatible)
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_BUCKET_NAME=campuscare-apex-production
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_REGION_NAME=ap-south-1

# Redis / Outbox & Cache (EV-1..EV-3)
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis.production.internal:6379/0

# AI Provider Gateway & Fallback Configuration (NR-8, B2)
AI_GATEWAY_ENABLED=true
AI_PROVIDER=anthropic
AI_API_KEY=REPLACE_WITH_AI_PROVIDER_KEY
AI_FALLBACK_MODEL=claude-3-5-haiku-20241022

# Telemetry & Monitoring (C1)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.monitoring.internal:4317
OTEL_SERVICE_NAME=campuscare-backend
SENTRY_DSN=https://sample_sentry_key@sentry.io/campuscare
