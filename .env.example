# ==============================================================================
# CampusCare AI Environment Variables Configuration
# Copy this file to .env and replace placeholder values for your local environment.
# Rule NR-7: No secrets in source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_SECRET_KEY=change-this-in-production-to-at-least-32-random-bytes

# Database Configuration (PostgreSQL 18 with Forced Row-Level Security)
# DB_MIGRATOR_URL: Used exclusively by Alembic migrations to create tables and RLS policies
DB_MIGRATOR_URL=postgresql+psycopg://campuscare_migrator:campuscare_migrator_pass@localhost:5433/campuscare

# DB_APP_URL: Used by the FastAPI runtime application (NOBYPASSRLS role)
DB_APP_URL=postgresql+psycopg://campuscare_app:campuscare_app_pass@localhost:5433/campuscare

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Session & Security Settings
SESSION_COOKIE_NAME=campuscare_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_SECONDS=86400
MFA_ISSUER=CampusCareAI

# AI Gateway Configuration (Rule NR-8: Product operates fully if AI is disabled/fallback)
AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=mock-key-not-for-production
AI_MODEL_NAME=gemini-2.5-flash

# Storage & Object Service
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=campuscare-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
